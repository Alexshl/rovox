@@ -518,7 +518,7 @@ public:
 
     double speedRatio = 1.0, readPosition = 0.0;
     float gains[2] = { 1.0f, 1.0f };
-    bool failedToRead = false;
+    bool failedToRead = false, wasPassingThrough = false;
 
     SampleCount getReadPosition() const
     {
@@ -559,6 +559,26 @@ public:
         const auto ratio = sampleRatio * speedRatio;
         assert (ratio > 0.0);
 
+        // ROVOX PATCH: nothing to convert (same rate, normal speed): pass the source through bit-exact; the sinc filter would change the samples
+        if (ratio == 1.0)
+        {
+            if (! std::exchange (wasPassingThrough, true))
+                src_reset (src_state);
+
+            auto view = destBuffer;
+
+            if (! source->readSamples (view))
+            {
+                destBuffer.clear();
+                return false;
+            }
+
+            readPosition += numFramesToDo;
+            return true;
+        }
+
+        wasPassingThrough = false;
+
         const auto numRead = src_callback_read (src_state, 1.0 / ratio,
                                                 static_cast<long> (numFramesToDo),
                                                 interleavedOutputScratchBuffer.getView().data.data);
@@ -571,7 +591,7 @@ public:
         }
 
         choc::buffer::copy (destBuffer, interleavedOutputScratchBuffer.getStart (numFramesToDo));
-        readPosition += numFramesToDo;
+        readPosition += numFramesToDo * speedRatio;     // ROVOX PATCH: setPosition() compares this with the clip-time position, which advances by speedRatio per output frame; without it every block was a jump (src_reset + seek)
 
         return true;
     }

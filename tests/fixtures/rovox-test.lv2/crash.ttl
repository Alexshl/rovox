@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<urn:rovox:test:crash-early>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Rovox Test Crash Early" ;
    doap:license <http://opensource.org/licenses/AGPL-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .

<urn:rovox:test:crash-late>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Rovox Test Crash Late" ;
    doap:license <http://opensource.org/licenses/AGPL-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .

<urn:rovox:test:pass>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Rovox Test Pass" ;
    doap:license <http://opensource.org/licenses/AGPL-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:rovox:test:crash-early> a lv2:Plugin ; lv2:binary <crash.so> ; rdfs:seeAlso <crash.ttl> .
<urn:rovox:test:crash-late>  a lv2:Plugin ; lv2:binary <crash.so> ; rdfs:seeAlso <crash.ttl> .
<urn:rovox:test:pass>        a lv2:Plugin ; lv2:binary <crash.so> ; rdfs:seeAlso <crash.ttl> .
<urn:rovox:test:beep>        a lv2:Plugin ; lv2:binary <beep.so>  ; rdfs:seeAlso <beep.ttl> .

// Test fixture written for Rovox (not a REAPER file): a gain with a mode switch. No extension, as REAPER's own effects.
desc:Rovox test gain
slider1:0<-60,12,0.1>Gain (dB)
slider2:0<0,2,1{Normal,Mute,Invert}>Mode

in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init
g = 1;

@slider
gain = 10^(slider1/20);
mode = slider2|0;
g = mode == 1 ? 0 : (mode == 2 ? -gain : gain);

@sample
spl0 *= g;
spl1 *= g;
